{
  "name": "inkwell",
  "productName": "Inkwell",
  "version": "1.0.0",
  "description": "A writing assistant for Windows and macOS: grammar, spelling, style and AI rewrites in any app.",
  "main": "src/main/main.js",
  "author": "Inkwell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomerezri-dev/Dream-Valley.git",
    "directory": "inkwell"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.inkwell.desktop",
    "productName": "Inkwell",
    "copyright": "Copyright © 2026 Inkwell",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Inkwell uses System Events to copy your selected text and paste the corrected version back.",
        "NSAccessibilityUsageDescription": "Inkwell reads the text you select so it can check it."
      }
    },
    "dmg": {
      "title": "Inkwell ${version}",
      "artifactName": "Inkwell-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inkwell",
      "artifactName": "Inkwell-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Inkwell-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
